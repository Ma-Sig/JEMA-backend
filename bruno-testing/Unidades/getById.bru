meta {
  name: getById
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/api/unidades/:id
  body: none
  auth: inherit
}

params:path {
  id: {{unidadId}}
}

script:post-response {
  const jsonResponse = res.body;
  
  bru.setEnvVar('unidadId', jsonResponse.id_unidad);
  
  test('Respuesta 200', () => {
      expect(res.status).to.equal(200);
  });
  
  test('Regresa un json con los campos correspondientes', () => {
      expect(jsonResponse).to.be.a('object');
      expect(jsonResponse).to.have.property('nombre');
      expect(jsonResponse.nombre).to.be.a('string');
      expect(jsonResponse.nombre).to.equal(bru.getEnvVar('unidadNombre'));
      expect(jsonResponse).to.have.property('id_unidad');
      expect(jsonResponse.id_unidad).to.be.a('number');
      expect(jsonResponse.id_unidad).to.equal(bru.getEnvVar('unidadId'));
  });
  
}
